erDiagram
    direction TB

    %% ============================================================
    %% AUDIT-FIRST / COMPLIANCE-DRIVEN DATA ARCHITECTURE
    %% 45 tables (24 [V] + 3 [L-E] + 4 [L-W] + 2 [L-S] + 12 [A])
    %% ============================================================
    %%
    %% Tres niveles de jerarquía (source-of-truth vs proyección):
    %%
    %% [V] PROYECCION — Estado actual derivado de eventos.
    %%     Cada cambio genera nueva fila (vigente_desde / vigente_hasta).
    %%     Es la vista de "current state" para la app. NO es fuente de verdad
    %%     histórica: la historia vive en los eventos [L] y los hechos [A].
    %%     Enforce: UPDATE crea nueva versión. DELETE nunca.
    %%
    %% [L] EVENTO DE LIFECYCLE — Tres subtipos con reglas distintas:
    %%
    %%   [L-E] EVENTO PURO — append-only. El estado se DERIVA de otros
    %%         eventos registrados. NO se muta el estado.
    %%         Tablas: ingreso, facturas, factura_electronica.
    %%         Enforce: INSERT-only.
    %%         Ej: factura_electronica.estado='revocada' se infiere de la
    %%         existencia de una fila en `revocacion_factura` apuntando
    %%         a esta e-factura.
    %%
    %%   [L-W] WORKFLOW — transiciones de estado registradas como NUEVAS
    %%         filas con FK `uuid_padre` al original (cadena de workflow).
    %%         La "última fila de la cadena" es el estado vigente.
    %%         Tablas: anulaciones, reclamos, alerta, reimpresion_ticket.
    %%         Enforce: INSERT-only. UPDATE/DELETE prohibidos.
    %%         Ej: anulaciones recorre 'solicitada' → 'aprobada' →
    %%         'ejecutada' como tres filas encadenadas por uuid_padre.
    %%
    %%   [L-S] SESIÓN/CICLO — UPDATE legítimo sobre campos estado/cierre
    %%         con log_transaccional OBLIGATORIO en la misma TX.
    %%         Tablas: login, sesion.
    %%         Enforce: UPDATE solo sobre `estado` y `fecha_cierre`;
    %%         cualquier otro campo no se muta.
    %%         Ej: logout → UPDATE login SET estado='cerrado' +
    %%         INSERT log_transaccional en la misma TX.
    %%
    %% [A] SOURCE-OF-TRUTH — Inmutable enforced.
    %%     Append-only estricto. REVOKE UPDATE/DELETE a nivel DB.
    %%     Excepción operacional: sync_queue admite UPDATE de campos
    %%     operacionales (estado, intentos, next_retry_at, ultimo_error)
    %%     porque es cola de trabajo, no registro histórico.
    %%     Cadena de hash en log_transaccional y revocacion_factura para
    %%     evidencia probatoria ante DIAN.
    %%     Enforce: REVOKE UPDATE, DELETE FROM rol_app ON [A]_tables
    %%              (excepto sync_queue). Triggers RAISE EXCEPTION.
    %%
    %% COLUMNAS COMUNES PARA AUDIT-FIRST:
    %%   - timestamp_evento: cuándo ocurrió el hecho en el negocio
    %%     (distinto de created_at, que es cuándo el DB lo registró)
    %%   - fecha_retencion_hasta: hasta cuándo debe retenerse la fila
    %%     (DIAN exige 5+ años para facturas; configurable por tipo)
    %%   - hash_anterior / hash_actual: cadena de integridad en logs críticos
    %%     (log_transaccional, revocacion_factura)
    %%   - uuid_padre: FK a sí misma para tablas [L-W] (cadena de workflow)
    %%
    %% ESTADO vs EVENTO (regla general):
    %%   - [L-E]: estado derivado de otros eventos. NO se muta.
    %%   - [L-W]: estado es la última fila de la cadena uuid_padre.
    %%   - [L-S]: estado se muta con log obligatorio en log_transaccional.
    %%   - [V]: estado es lifecycle operativo (activo/inactivo/archivado),
    %%     NO se confunde con validez temporal (vigente_desde/hasta).

    %% ============================================================
    %% [V] PROYECCION (current state) - Usuarios y autenticación
    %% ============================================================

    %% usuarios: Usuarios del sistema (admin, operador, supervisor).
    %% La cédula es el identificador legal; el email es el login identifier.
    %% password_hash es bcrypt (nunca plain text). Cada cambio de atributos
    %% genera nueva fila (versión) — incluye reset de password. Las FKs a
    %% esta tabla apuntan a la versión vigente al INSERT y NO se migran.
    %% AUDIT-FIRST: esta tabla es PROYECCION de estado actual. La historia
    %% de quién creó / desactivó / reasignó rol a este usuario vive en
    %% log_transaccional (source-of-truth). El campo `estado` es lifecycle
    %% operativo; un "borrado lógico" se registra como nueva versión con
    %% vigente_hasta=NOW() y evento en log_transaccional.
    usuarios {
        %% [V] Business
        uuid uuid PK
        string nombre
        string apellido
        string cedula
        string email
        string password_hash
        timestamp fecha_cambio_password
        string rol
        %% Audit
        timestamp created_at
        uuid created_by
        %% Versioning
        timestamp vigente_desde
        timestamp vigente_hasta
        string estado
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% permisos: Catálogo de permisos del sistema.
    %% Ejemplos: crear_usuario, facturar, cerrar_caja, ver_reportes.
    %% Cada permiso es una fila versionable.
    permisos {
        %% [V] Business
        uuid uuid PK
        string permiso
        %% Audit
        timestamp created_at
        uuid created_by
        %% Versioning
        timestamp vigente_desde
        timestamp vigente_hasta
        string estado
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% permisos_usuario: Tabla puente que asigna permisos a usuarios.
    %% Cada asignación es versionable (se puede revocar y reasignar).
    permisos_usuario {
        %% [V] Business
        uuid uuid PK
        uuid uuid_usuario FK
        uuid uuid_permiso FK
        %% Audit
        timestamp created_at
        uuid created_by
        %% Versioning
        timestamp vigente_desde
        timestamp vigente_hasta
        string estado
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% ============================================================
    %% [V] PROYECCION (current state) - Catálogos
    %% ============================================================

    %% tipo_persona: Tipos de persona del sistema.
    %% Valores: 'natural', 'juridica', 'final' (consumidor final).
    tipo_persona {
        %% [V]
        uuid uuid PK
        string tipo
        timestamp created_at
        uuid created_by
        timestamp vigente_desde
        timestamp vigente_hasta
        string estado
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% tipos_vehiculo: Tipos de vehículo soportados.
    %% Ejemplos: automovil, moto, camioneta, bicicleta.
    tipos_vehiculo {
        %% [V]
        uuid uuid PK
        string tipo
        timestamp created_at
        uuid created_by
        timestamp vigente_desde
        timestamp vigente_hasta
        string estado
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% tipo_subscripciones: Planes de subscripción disponibles.
    %% Campos clave para restricciones de negocio:
    %%   - cantidad_maxima_vehiculos: tope por subscripción
    %%   - mismo_tipo_vehiculo: TRUE para B2C, FALSE para B2B
    %%   - tipo_cliente_permitido: 'b2c' | 'b2b' | 'ambos'
    tipo_subscripciones {
        %% [V]
        uuid uuid PK
        string tipo
        decimal valor
        int duracion_dias
        int cantidad_maxima_vehiculos
        bool mismo_tipo_vehiculo
        string tipo_cliente_permitido
        timestamp created_at
        uuid created_by
        timestamp vigente_desde
        timestamp vigente_hasta
        string estado
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% tipo_tarifa: Modalidades de tarifa.
    %% Valores: 'por_hora', 'por_minuto', 'plena' (tarifa B2B).
    tipo_tarifa {
        %% [V]
        uuid uuid PK
        string tipo
        timestamp created_at
        uuid created_by
        timestamp vigente_desde
        timestamp vigente_hasta
        string estado
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% tipo_sucursal: Tipos de sucursal según tamaño e infraestructura.
    %% Seed: C (Pequeño sin barreras), B (Mediano con talanqueras), A (Grande + sensores).
    %% caracteristicas JSON documenta hardware disponible por tipo.
    tipo_sucursal {
        %% [V]
        uuid uuid PK
        string codigo
        string nombre
        text descripcion
        json caracteristicas
        timestamp created_at
        uuid created_by
        timestamp vigente_desde
        timestamp vigente_hasta
        string estado
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% impuestos: Catálogo de impuestos aplicables a facturas.
    %% tipo_calculo: 'porcentaje' | 'fijo'.
    %% base_calculo: 'subtotal' | 'subtotal_con_impuestos'.
    %% El versionado es crítico para DIAN: una factura emitida con
    %% IVA 19% debe quedar asociada al registro histórico de ese 19%.
    impuestos {
        %% [V]
        uuid uuid PK
        string nombre
        string codigo
        decimal porcentaje
        string tipo_calculo
        string base_calculo
        timestamp created_at
        uuid created_by
        timestamp vigente_desde
        timestamp vigente_hasta
        string estado
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% otros_cobros: Cargos adicionales parametrizables (no son impuestos).
    %% Ejemplos: tarifa nocturna, cargo por evento, etc.
    otros_cobros {
        %% [V]
        uuid uuid PK
        string nombre
        decimal costo
        string tipo_calculo
        string base_calculo
        timestamp created_at
        uuid created_by
        timestamp vigente_desde
        timestamp vigente_hasta
        string estado
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% costos_servicios: Catálogo de costos por servicios puntuales.
    %% Conceptos: reimpresion_ticket, segunda_via_factura, certificados.
    %% Cada servicio tiene su costo snapshot al momento de uso.
    costos_servicios {
        %% [V]
        uuid uuid PK
        string concepto
        decimal costo
        string tipo_calculo
        timestamp created_at
        uuid created_by
        timestamp vigente_desde
        timestamp vigente_hasta
        string estado
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% configuracion_tolerancias: Tolerancias operativas globales (singleton).
    %% Una sola fila activa. Cambio genera nueva versión para preservar histórico.
    %% Usada por arqueo para decidir si genera alerta diferencia_arqueo.
    configuracion_tolerancias {
        %% [V]
        uuid uuid PK
        decimal tolerancia_efectivo
        decimal tolerancia_datafono
        timestamp created_at
        uuid created_by
        timestamp vigente_desde
        timestamp vigente_hasta
        string estado
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% configuracion_seguridad: Políticas de seguridad/credenciales globales.
    %% Singleton. controla expiración de passwords, intentos de login, bloqueos.
    %% Seed: 30 días expiración, 5 intentos, 15 min bloqueo.
    configuracion_seguridad {
        %% [V]
        uuid uuid PK
        int dias_expiracion_password
        int max_intentos_login
        int minutos_bloqueo_login
        timestamp created_at
        uuid created_by
        timestamp vigente_desde
        timestamp vigente_hasta
        string estado
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% empresa: Datos del emisor (la cadena de parqueaderos dueña de todas
    %% las sucursales). Singleton corporativo versionable: UNA fila activa
    %% a la vez; cualquier cambio genera nueva versión para preservar
    %% auditoría. Define la identidad corporativa que se replica en cada
    %% `sucursal` (NIT, regimen, mensajes de bienvenida/salida) y la
    %% numeración DIAN (resolución, prefijo, rango desde/hasta, consecutivo
    %% actual). Las `sucursal` no duplican estos campos: los leen de
    %% `empresa` en queries JOIN. Cada `sucursal` agrega solo `direccion`,
    %% `telefono` y `prefijo_nombre` (datos locales de la sede física).
    %% El `numero_factura` final que se imprime es
    %% `{empresa.prefijo_factura}-{consecutivo_actual con padding}`; la
    %% numeración es atómica vía `UPDATE empresa SET consecutivo_actual =
    %% consecutivo_actual + 1 WHERE uuid = ? AND consecutivo_actual <=
    %% rango_hasta` dentro de la misma TX del pago. Si `consecutivo_actual`
    %% supera `rango_hasta`, el endpoint retorna 409 `rango_agotado` y el
    %% admin debe cargar una nueva resolución.
    %% AUDIT-FIRST: consecutivo_actual es el ÚNICO campo mutable de esta
    %% tabla (atomic counter para numeración DIAN). Todo lo demás es
    %% versionado: cambio de NIT, resolución, regimen → nueva fila + log.
    empresa {
        %% [V] Business
        uuid uuid PK
        string nombre
        string nit
        string mensaje_bienvenida
        string mensaje_salida
        string regimen
        string resolucion_facturacion
        string prefijo_factura
        bigint rango_desde
        bigint rango_hasta
        bigint consecutivo_actual
        %% Audit
        timestamp created_at
        uuid created_by
        %% Versioning
        timestamp vigente_desde
        timestamp vigente_hasta
        string estado
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% ============================================================
    %% [V] PROYECCION (current state) - Sucursales
    %% ============================================================

    %% sucursal: Cada sucursal física del parqueadero.
    %% horario es un string simple (considerar tabla aparte si se
    %% necesitan excepciones por feriado o mantenimiento).
    %% uuid_tipo_sucursal determina tamaño/infra (C=sin barreras, B=talanqueras, A=sensores).
    %% Los datos corporativos del emisor (NIT, regimen, mensajes, resolución
    %% DIAN, prefijo y rango de facturación) NO viven aquí: se leen de
    %% `empresa` en queries JOIN. Esta tabla solo agrega los datos LOCALES
    %% de la sede: `direccion` (calle + número), `telefono` (línea de
    %% atención) y `prefijo_nombre` (ej: "Sucursal Norte — Bogota", se
    %% muestra en tickets y comprobantes para identificar la sede).
    sucursal {
        %% [V]
        uuid uuid PK
        string nombre
        string direccion
        string telefono
        string prefijo_nombre
        string ciudad
        string horario
        uuid uuid_tipo_sucursal FK
        timestamp created_at
        uuid created_by
        timestamp vigente_desde
        timestamp vigente_hasta
        string estado
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% usuarios_sucursal: Tabla puente usuario ↔ sucursal.
    %% Define a qué sucursales tiene acceso cada usuario.
    usuarios_sucursal {
        %% [V]
        uuid uuid PK
        uuid uuid_sucursal FK
        uuid uuid_usuario FK
        timestamp created_at
        uuid created_by
        timestamp vigente_desde
        timestamp vigente_hasta
        string estado
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% documentos: Documentos asociados a sucursales.
    %% Tipos: licencias, contratos, permisos municipales.
    %% documento_b64 almacena el contenido (PDF, JPG).
    documentos {
        %% [V]
        uuid uuid PK
        uuid uuid_sucursal FK
        string tipo
        string formato
        text documento_b64
        timestamp created_at
        uuid created_by
        timestamp vigente_desde
        timestamp vigente_hasta
        string estado
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% tarifas_sucursal: Tarifa por (sucursal, tipo_vehiculo, tipo_tarifa).
    %% CRÍTICO: el versionado es obligatorio para facturación histórica.
    %% Un ticket emitido con la tarifa del 2024-01-01 debe calcularse
    %% con esos valores aunque la tarifa actual sea otra.
    %% AUDIT-FIRST: además del versionado (vigente_desde/hasta), cada
    %% cambio de tarifa DEBE registrar un evento en log_transaccional
    %% con datos_anteriores y datos_nuevos para trazabilidad probatoria
    %% ante DIAN (no alcanza con la nueva fila; se necesita el evento).
    tarifas_sucursal {
        %% [V]
        uuid uuid PK
        uuid uuid_sucursal FK
        uuid uuid_tipo_vehiculo FK
        uuid uuid_tipo_tarifa FK
        decimal valor
        decimal valor_plena
        timestamp created_at
        uuid created_by
        timestamp vigente_desde
        timestamp vigente_hasta
        string estado
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% cantidad_vehiculos_sucursal: Capacidad o conteo por sucursal/tipo de vehículo.
    cantidad_vehiculos_sucursal {
        %% [V]
        uuid uuid PK
        uuid uuid_sucursal FK
        uuid uuid_tipo_vehiculo FK
        int cantidad
        timestamp created_at
        uuid created_by
        timestamp vigente_desde
        timestamp vigente_hasta
        string estado
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% ============================================================
    %% [V] PROYECCION (current state) - Clientes y subscripciones
    %% ============================================================

    %% clientes: Clientes del sistema, tanto B2C (naturales) como B2B.
    %% tipo_identificador puede ser 'consumidor_final' (seed UUID fijo).
    %% El cliente B2B se determina por la presencia de fila en clientes_b2b.
    %% registro: configuración a nivel cliente (aplica a B2C y B2B).
    %%          Ver sección "Campos JSON: registro" en modelo_datos.md.
    clientes {
        %% [V]
        uuid uuid PK
        string tipo_identificador
        string numero_identificacion
        string nombre
        string apellido
        string telefono
        string email
        uuid uuid_tipo_persona FK
        json registro
        timestamp created_at
        uuid created_by
        timestamp vigente_desde
        timestamp vigente_hasta
        string estado
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% clientes_b2b: Extensión B2B del cliente (contratos corporativos).
    %% Relación 1:1 opcional con clientes.
    %% registro: configuración específica del CONTRATO B2B (no del cliente).
    %%          Ver sección "Campos JSON: registro" en modelo_datos.md.
    clientes_b2b {
        %% [V]
        uuid uuid PK
        uuid uuid_cliente FK
        int cantidad
        json registro
        date fecha_vencimiento
        timestamp created_at
        uuid created_by
        timestamp vigente_desde
        timestamp vigente_hasta
        string estado
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% subscripciones_cliente: Subscripción de un cliente en una sucursal.
    %% Asocia cliente + sucursal + tipo_subscripcion. Los vehículos
    %% asociados se vinculan via subscripcion_vehiculos.
    subscripciones_cliente {
        %% [V]
        uuid uuid PK
        uuid uuid_cliente FK
        uuid uuid_sucursal FK
        uuid uuid_tipo_subscripcion FK
        date fecha_vencimiento
        timestamp created_at
        uuid created_by
        timestamp vigente_desde
        timestamp vigente_hasta
        string estado
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% ============================================================
    %% [V] PROYECCION (current state) - Vehículos
    %% ============================================================

    %% vehiculos: Vehículos con subscripción activa.
    %% Solo se persisten para vehículos subscritos. Los vehículos
    %% ocasionales quedan como 'placa' string en ingreso/salidas.
    %% La placa es UNIQUE por negocio.
    vehiculos {
        %% [V]
        uuid uuid PK
        string placa
        uuid uuid_tipo_vehiculo FK
        timestamp created_at
        uuid created_by
        timestamp vigente_desde
        timestamp vigente_hasta
        string estado
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% subscripcion_vehiculos: Relación N:M entre subscripciones_cliente y vehículos.
    %% Resuelve el problema de 1NF de tener placavehiculo1, placavehiculo2.
    subscripcion_vehiculos {
        %% [V]
        uuid uuid PK
        uuid uuid_subscripcion_cliente FK
        uuid uuid_vehiculo FK
        timestamp created_at
        uuid created_by
        timestamp vigente_desde
        timestamp vigente_hasta
        string estado
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% ============================================================
    %% [L] EVENTO DE LIFECYCLE - Operación
    %% ============================================================

    %% login [L-S]: Auditoría de cada intento de login.
    %% El estado recorre 'exitoso' → 'cerrado' (logout), o queda en 'fallido'.
    %% uuid_sucursal: dónde ocurrió el login (para multi-tenancy).
    %% AUDIT-FIRST [L-S]: `timestamp` es el momento del intento (negocio);
    %% `created_at` es cuándo la DB lo registró. Pueden diferir si la
    %% sucursal estaba offline (diferencia = tiempo en cola de sync).
    %% UPDATE legítimo: SET estado='cerrado' en logout — registra
    %% OBLIGATORIAMENTE fila en log_transaccional en la misma TX.
    %% UPDATE sobre cualquier otro campo prohibido.
    login {
        %% [L-S] Business
        uuid uuid PK
        uuid uuid_usuario FK
        uuid uuid_sucursal FK
        timestamp timestamp_evento "cuándo ocurrió el intento en el negocio"
        %% Lifecycle (UPDATE permitido solo en logout, con log obligatorio)
        string estado "exitoso | fallido | cerrado"
        %% Audit
        timestamp created_at "cuándo la DB registró la fila"
        uuid created_by
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% ingreso [L-E]: Registro de cada vehículo que entra al parqueadero.
    %% placa es string (captura en puerta), uuid_subscripcion_cliente es
    %% NULL para ocasionales o para vehículos que entran por
    %% rotación (cupo de subscripción ya ocupado).
    %% AUDIT-FIRST [L-E]: append-only. El campo `estado` se DERIVA de eventos:
    %%   - 'activo' → no hay fila en `salidas` ni en `anulaciones` para este ingreso.
    %%   - 'cerrado' → existe fila en `salidas` con fecha_salida.
    %%   - 'anulado' → existe fila en `anulaciones` apuntando a este ingreso.
    %% NO se UPDATEa esta fila: se inserta el evento correspondiente.
    %% fecha_salida se deriva de `salidas` (mantener acá por query speed,
    %% pero la fuente de verdad es la fila en `salidas`).
    ingreso {
        %% [L-E] Business
        uuid uuid PK
        uuid uuid_sucursal FK
        string placa
        uuid uuid_tipo_vehiculo FK
        uuid uuid_subscripcion_cliente FK
        timestamp fecha_ingreso
        timestamp fecha_salida "derivado de salidas — fuente: tabla salidas"
        text observaciones
        %% Lifecycle (DERIVADO — no se muta)
        string estado "activo | cerrado | anulado (derivado de eventos)"
        %% Audit
        timestamp created_at
        uuid created_by
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% reimpresion_ticket [L-W]: Cada reimpresión de un ticket con su costo.
    %% costo_aplicado es snapshot de costos_servicios al momento.
    %% uuid_factura siempre presente (cobrada en factura existente
    %% o nueva). El operador nunca puede dejar la reimpresión gratuita.
    %% AUDIT-FIRST [L-W]: append-only. Una reimpresión anulada se modela
    %% como NUEVA fila con uuid_padre apuntando a la original y
    %% estado='anulada'. El estado vigente = última fila de la cadena.
    %% Valores de estado (alineados a .md sección 2.8): 'cobrada' | 'anulada'.
    reimpresion_ticket {
        %% [L-W] Business
        uuid uuid PK
        uuid uuid_sucursal FK
        uuid uuid_ingreso FK
        uuid uuid_usuario FK
        uuid uuid_costo_servicio FK
        decimal costo_aplicado
        uuid uuid_factura FK
        string motivo
        uuid uuid_padre FK "anulación: nueva fila apunta a la reimpresión original"
        timestamp timestamp_evento "cuándo se solicitó la reimpresión"
        %% Lifecycle (workflow — cada transición es nueva fila)
        string estado "cobrada | anulada"
        %% Audit
        timestamp created_at
        uuid created_by
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% anulaciones [L-W]: Workflow de anulación de ingresos por el admin.
    %% uuid_usuario registra quién autorizó la anulación.
    %% AUDIT-FIRST [L-W]: append-only. La anulación recorre un workflow
    %% de aprobación: 'solicitada' → 'aprobada' → 'ejecutada'.
    %% Cada transición es una NUEVA fila encadenada por uuid_anulacion_padre.
    %% La fila raíz (uuid_anulacion_padre IS NULL) es la solicitud inicial.
    %% La "anulación efectiva" sobre el ingreso es la fila con
    %% estado='ejecutada'. NO se UPDATEa esta fila: se inserta la transición.
    anulaciones {
        %% [L-W] Business
        uuid uuid PK
        uuid uuid_sucursal FK
        uuid uuid_ingreso FK "ingreso afectado (todas las filas de la cadena apuntan al mismo ingreso)"
        uuid uuid_usuario FK "usuario que ejecuta esta transición"
        text motivo
        uuid uuid_anulacion_padre FK "FK a la fila anterior de la cadena (NULL = solicitud inicial)"
        timestamp timestamp_evento "cuándo se ejecutó esta transición"
        %% Lifecycle (workflow — valores alineados a .md sección 2.8)
        string estado "solicitada | aprobada | ejecutada"
        %% Audit
        timestamp created_at
        uuid created_by
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% reclamos [L-W]: Reclamos de clientes sobre cualquier entidad.
    %% FK polimórfica: tipo_reclamable indica a qué tabla apunta
    %% uuid_reclamable (ingreso, salida, factura, subscripcion).
    %% AUDIT-FIRST [L-W]: append-only. El reclamo recorre workflow:
    %% 'abierto' → 'en_revision' → 'resuelto' (o 'rechazado').
    %% Cada transición es NUEVA fila con uuid_reclamo_padre apuntando
    %% a la anterior. La fila raíz (uuid_reclamo_padre IS NULL) es la
    %% presentación original del reclamo. El estado vigente es la
    %% última fila de la cadena.
    reclamos {
        %% [L-W] Business
        uuid uuid PK
        uuid uuid_sucursal FK
        string tipo_reclamable "ingreso | salida | factura | subscripcion"
        uuid uuid_reclamable "FK al registro según tipo_reclamable"
        text motivo
        uuid uuid_reclamo_padre FK "FK a la fila anterior (NULL = reclamo inicial)"
        timestamp timestamp_evento "cuándo se presentó / se ejecutó la transición"
        %% Lifecycle (workflow — cada transición es nueva fila)
        string estado "abierto | en_revision | resuelto | rechazado"
        %% Audit
        timestamp created_at
        uuid created_by
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% ============================================================
    %% [L] EVENTO DE LIFECYCLE - Facturación
    %% ============================================================

    %% facturas [L-E]: Factura de negocio (registro de la transacción).
    %% Es el documento de negocio; factura_electronica es la
    %% representación fiscal. Subtotal + descuento + impuestos
    %% + otros cobros = total.
    %% uuid_sucursal: filtrado directo (transitivo via ingreso/salida).
    %% AUDIT-FIRST [L-E]: append-only. La factura de negocio NO se muta:
    %% una vez emitida permanece inmutable. Su anulación (si ocurre) se
    %% registra en `anulaciones` apuntando a `uuid_ingreso` (no a esta
    %% tabla). El campo `estado` se DERIVA:
    %%   - 'activa' → fila recién creada, sin evento de anulación vinculado.
    %%   - 'anulada' → existe fila en `anulaciones` con estado='ejecutada'
    %%     apuntando al mismo uuid_ingreso.
    %% NO se UPDATEa esta fila. La revocación DIAN es evento inmutable
    %% en `revocacion_factura` y opera sobre `factura_electronica`, no
    %% sobre esta tabla (la factura de negocio permanece).
    %% RETENCION DIAN: 5 años mínimo desde la fecha de emisión.
    facturas {
        %% [L-E] Business
        uuid uuid PK
        uuid uuid_sucursal FK
        decimal subtotal
        decimal descuento
        decimal total
        uuid uuid_ingreso FK
        uuid uuid_salida FK
        %% Lifecycle (DERIVADO — no se muta)
        string estado "activa | anulada (derivado de anulaciones)"
        %% Retention (DIAN)
        date fecha_retencion_hasta "DIAN: 5+ años desde emisión"
        %% Audit
        timestamp created_at
        uuid created_by
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% factura_electronica [L-E]: Representación fiscal enviada a DIAN.
    %% uuid_cliente puede ser consumidor_final_default (seed UUID).
    %% Permite revocar y reemitir (reemision_consumidor_final).
    %% uuid_sucursal: filtrado directo (transitivo via factura).
    %% `consecutivo` es el número crudo del rango DIAN asignado a esta
    %% factura (atómico desde `empresa.consecutivo_actual` en la TX del
    %% pago). El `numero_factura` que se imprime al cliente se compone en
    %% código como `empresa.prefijo_factura || '-' || lpad(consecutivo)`.
    %% AUDIT-FIRST [L-E]: append-only. El `estado` se DERIVA de eventos:
    %%   - 'activa' → recién creada, sin fila en `revocacion_factura`
    %%     donde esta fila es uuid_factura_electronica.
    %%   - 'revocada' → existe fila en `revocacion_factura` apuntando
    %%     a esta fila (uuid_factura_electronica).
    %%   - 'anulada' → anulada directamente (sin reemplazo).
    %% NO se UPDATEa esta fila. La revocación implica INSERT en
    %% `revocacion_factura` (con cadena de hash para DIAN); el lector
    %% interpreta el estado a partir de esa existencia. La factura
    %% original NO se reemplaza — se inserta una NUEVA factura_electronica
    %% y `revocacion_factura.uuid_factura_electronica_reemplazo` la apunta.
    %% RETENCION DIAN: 5+ años.
    factura_electronica {
        %% [L-E] Business
        uuid uuid PK
        uuid uuid_sucursal FK
        uuid uuid_factura FK
        uuid uuid_cliente FK
        bool reportado_dian
        decimal descuento
        bigint consecutivo
        %% Lifecycle (DERIVADO — no se muta)
        string estado "activa | revocada | anulada (derivado de revocacion_factura)"
        %% Retention (DIAN)
        date fecha_retencion_hasta "DIAN: 5+ años desde emisión"
        %% Audit
        timestamp created_at
        uuid created_by
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% ============================================================
    %% [L] EVENTO DE LIFECYCLE - Caja y sesión
    %% ============================================================

    %% sesion [L-S]: Turno de operación (apertura/cierre de caja).
    %% Un operador abre sesión al iniciar, la cierra al final.
    %% AUDIT-FIRST [L-S]: `estado` recorre 'abierta' → 'cerrada'.
    %% UPDATE legítimo: SET estado='cerrada', timestamp_cierre=NOW()
    %% al cerrar sesión — registra OBLIGATORIAMENTE fila en
    %% log_transaccional en la misma TX. El arqueo asociado queda
    %% referenciado vía uuid_sesion en arqueo (no UUID directo acá).
    sesion {
        %% [L-S] Business
        uuid uuid PK
        decimal valor_inicial_efectivo
        decimal valor_inicial_datafono
        uuid uuid_sucursal FK
        uuid uuid_usuario FK
        timestamp timestamp_apertura
        timestamp timestamp_cierre "set en UPDATE de cierre (con log obligatorio)"
        %% Lifecycle (UPDATE permitido solo en cierre, con log obligatorio)
        string estado "abierta | cerrada"
        %% Audit
        timestamp created_at
        uuid created_by
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% alerta [L-W]: Alertas del sistema (operacionales y de sync).
    %% tipo_alerta incluye: diferencia_arqueo, caja_baja, fraude,
    %% manual, sync_failure, branch_offline.
    %% AUDIT-FIRST [L-W]: append-only. La alerta recorre workflow:
    %% 'abierta' → 'en_revision' → 'resuelta'. Cada transición es
    %% NUEVA fila con uuid_alerta_padre apuntando a la anterior.
    %% La fila raíz (uuid_alerta_padre IS NULL) es la alerta original
    %% disparada por el sistema. El estado vigente es la última fila
    %% de la cadena. Cuando la conectividad se restablece, el worker
    %% inserta nueva fila 'resuelta' para cerrar alertas sync.
    alerta {
        %% [L-W] Business
        uuid uuid PK
        uuid uuid_sucursal FK
        uuid uuid_usuario FK "responsable actual de la alerta"
        uuid uuid_arqueo FK "NULL si no proviene de arqueo"
        string tipo_alerta "diferencia_arqueo | caja_baja | fraude | manual | sync_failure | branch_offline"
        decimal valor_diferencia_efectivo
        decimal valor_diferencia_datafono
        uuid uuid_alerta_padre FK "FK a la fila anterior (NULL = alerta inicial)"
        timestamp timestamp_evento "cuándo ocurrió la condición / se ejecutó la transición"
        %% Lifecycle (workflow — cada transición es nueva fila)
        string estado "abierta | en_revision | resuelta"
        %% Audit
        timestamp created_at
        uuid created_by
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% ============================================================
    %% [A] SOURCE-OF-TRUTH (append-only) - Operación
    %% ============================================================

    %% salidas: Registro de cada vehículo que sale del parqueadero.
    %% Una fila por salida (1:1 con ingreso cuando sale).
    %% AUDIT-FIRST: source-of-truth para el cierre del ingreso. ENFORCE:
    %% REVOKE UPDATE, DELETE FROM rol_app. Inmutabilidad a nivel DB.
    salidas {
        %% [A] Business
        uuid uuid PK
        uuid uuid_sucursal FK
        uuid uuid_ingreso FK
        string placa
        timestamp fecha_salida
        %% Retention (operacional — corto, ej: 2 años; particionable por mes)
        date fecha_retencion_hasta
        %% Audit
        timestamp created_at
        uuid created_by
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% ============================================================
    %% [A] SOURCE-OF-TRUTH (append-only) - Facturación (snapshots)
    %% ============================================================

    %% factura_detalle: Líneas de factura (conceptos facturados).
    %% Opcional: solo si una factura puede tener múltiples líneas.
    %% uuid_sucursal: filtrado directo (transitivo via factura).
    %% AUDIT-FIRST: append-only enforced. Snapshot inmutable de los
    %% conceptos facturados al momento de emisión. Particionable por mes.
    factura_detalle {
        %% [A] Business
        uuid uuid PK
        uuid uuid_sucursal FK
        uuid uuid_factura FK
        string concepto
        int cantidad
        decimal valor_unitario
        decimal subtotal
        %% Retention (DIAN)
        date fecha_retencion_hasta "DIAN: 5+ años"
        %% Audit
        timestamp created_at
        uuid created_by
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% factura_impuestos: Snapshot de cada impuesto aplicado.
    %% porcentaje_aplicado es snapshot al momento de la facturación
    %% para que DIAN pueda verificar exactamente qué tasa se usó.
    %% uuid_sucursal: filtrado directo (transitivo via factura).
    %% AUDIT-FIRST: append-only enforced. CRÍTICO para DIAN — la tasa
    %% histórica aplicada NUNCA debe cambiar aunque se modifique el
    %% catálogo `impuestos`. Tabla candidata a hash-chaining si DIAN
    %% exige cadena de integridad sobre totales.
    factura_impuestos {
        %% [A] Business
        uuid uuid PK
        uuid uuid_sucursal FK
        uuid uuid_factura FK
        uuid uuid_impuesto FK
        decimal base_calculo
        decimal porcentaje_aplicado
        decimal valor
        %% Retention (DIAN)
        date fecha_retencion_hasta "DIAN: 5+ años"
        %% Audit
        timestamp created_at
        uuid created_by
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% factura_otros_cobros: Snapshot de otros cobros aplicados.
    %% uuid_sucursal: filtrado directo (transitivo via factura).
    %% AUDIT-FIRST: append-only enforced. Snapshot inmutable.
    factura_otros_cobros {
        %% [A] Business
        uuid uuid PK
        uuid uuid_sucursal FK
        uuid uuid_factura FK
        uuid uuid_otro_cobro FK
        decimal base_calculo
        decimal valor_aplicado
        decimal valor
        %% Retention (DIAN)
        date fecha_retencion_hasta "DIAN: 5+ años"
        %% Audit
        timestamp created_at
        uuid created_by
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% factura_pagos: Cada pago de una factura.
    %% Una factura puede tener varios pagos (mixto: efectivo + datafono).
    %% uuid_sucursal: filtrado directo (transitivo via factura).
    %% AUDIT-FIRST: append-only enforced. Snapshot del pago al momento de
    %% la transacción. CRÍTICO para arqueo de caja: la suma de pagos debe
    %% coincidir con el cierre de caja (validación cruzada en `arqueo`).
    factura_pagos {
        %% [A] Business
        uuid uuid PK
        uuid uuid_sucursal FK
        uuid uuid_factura FK
        string medio_pago
        decimal valor
        string referencia
        timestamp timestamp_evento "cuándo se recibió el pago en caja"
        %% Retention (DIAN + arqueo)
        date fecha_retencion_hasta "DIAN: 5+ años"
        %% Audit
        timestamp created_at
        uuid created_by
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% revocacion_factura: Cadena de revocaciones de e-facturas.
    %% uuid_factura_electronica_reemplazo forma la cadena: la e-factura
    %% original es revocada por esta fila, que apunta a su reemplazo.
    %% uuid_sucursal: filtrado directo (transitivo via e-factura).
    %% AUDIT-FIRST: cadena de hash para integridad probatoria ante DIAN.
    %% Cada revocación encadena con la anterior vía hash_anterior →
    %% hash_actual. Si alguien altera una fila histórica, el hash no
    %% coincide y la cadena se rompe (evidencia de tampering).
    %% hash_anterior = SHA256(uuid + uuid_sucursal + uuid_factura_electronica
    %%   + uuid_factura_electronica_reemplazo + motivo + timestamp
    %%   + hash_anterior de la revocación previa del mismo uuid_sucursal).
    %% hash_actual = SHA256(uuid + timestamp_registro + datos_canonicos).
    %% Única fila con hash_anterior NULL es la primera revocación por
    %% sucursal (semilla de la cadena).
    revocacion_factura {
        %% [A] Business
        uuid uuid PK
        uuid uuid_sucursal FK
        uuid uuid_factura_electronica FK
        uuid uuid_factura_electronica_reemplazo FK
        text motivo
        timestamp timestamp "cuándo se emitió la revocación (negocio)"
        %% Chain integrity (DIAN evidence)
        string hash_anterior "SHA256 de la revocación previa del mismo uuid_sucursal"
        string hash_actual "SHA256 de esta fila + hash_anterior"
        %% Retention (DIAN)
        date fecha_retencion_hasta "DIAN: 5+ años"
        %% Audit
        timestamp created_at "cuándo la DB registró la fila"
        uuid created_by
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% ============================================================
    %% [A] SOURCE-OF-TRUTH (append-only) - Caja
    %% ============================================================

    %% caja: Estado de caja por sucursal. Append-only.
    %% AUDIT-FIRST: cada fila es un snapshot del estado de caja en un
    %% momento dado. El "estado actual" de caja se reconstruye leyendo
    %% la última fila por sucursal. ENFORCE: REVOKE UPDATE, DELETE.
    caja {
        %% [A] Business
        uuid uuid PK
        uuid uuid_sucursal FK
        decimal valor_efectivo
        decimal valor_datafono
        %% Retention (operacional)
        date fecha_retencion_hasta "particionable por mes"
        %% Audit
        timestamp created_at
        uuid created_by
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% arqueo: Arqueo de caja al cierre de sesión.
    %% diferencia = reportado - esperado. Genera alerta si supera
    %% la tolerancia configurada.
    %% AUDIT-FIRST: append-only enforced. El arqueo es la fuente de verdad
    %% para el cierre de la `sesion` y para la generación de `alerta`.
    %% Si hay corrección del arqueo, se inserta una nueva fila con
    %% referencia al arqueo original (ver uuid_arquee_original si se agrega).
    arqueo {
        %% [A] Business
        uuid uuid PK
        uuid uuid_sucursal FK
        decimal valor_efectivo_esperado
        decimal valor_datafono_esperado
        decimal valor_efectivo_reportado
        decimal valor_datafono_reportado
        decimal diferencia_efectivo
        decimal diferencia_datafono
        %% Retention (operacional — 2 años; particionable por mes)
        date fecha_retencion_hasta
        %% Audit
        timestamp created_at
        uuid created_by
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% ============================================================
    %% [A] SOURCE-OF-TRUTH (append-only) - Sincronización y auditoría
    %% ============================================================

    %% sync_queue: Cola persistente de operaciones pendientes de sync.
    %% tabla + uuid_registro referencia cualquier tabla del modelo
    %% (FK polimórfica). datos es snapshot completo de la fila.
    %% Worker la procesa con backoff exponencial.
    %% AUDIT-FIRST: la cola SÍ se actualiza (estado, intentos, next_retry_at)
    %% — es operacional, no histórica. La transición append-only aplica a
    %% los eventos de sync_result (éxito/fallo) que se registran en
    %% `sync_log`, NO al estado interno de la cola.
    sync_queue {
        %% [A] Business (con estado mutable por diseño — ver comentario)
        uuid uuid PK
        uuid uuid_sucursal FK
        string operacion
        string tabla
        uuid uuid_registro
        json datos
        int prioridad
        string estado "pendiente | en_progreso | exitoso | fallido | descartado"
        int intentos
        timestamp next_retry_at
        text ultimo_error
        %% Audit
        timestamp created_at
        uuid created_by
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% sync_conflict: Log de conflictos detectados durante sync.
    %% politica define resolución: cloud_wins, local_wins, append,
    %% manual. Datos completos de ambas versiones para auditoría.
    %% AUDIT-FIRST: append-only enforced. Snapshot completo del conflicto
    %% para resolución posterior o auditoría.
    sync_conflict {
        %% [A] Business
        uuid uuid PK
        uuid uuid_sucursal FK
        string tabla
        uuid uuid_registro
        json datos_local
        json datos_cloud
        string politica
        string resolucion
        timestamp timestamp "cuándo se detectó el conflicto"
        %% Retention (operacional — 1 año post-resolución)
        date fecha_retencion_hasta
        %% Audit
        timestamp created_at
        uuid created_by
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% sync_log: Registro de cada ciclo de sincronización.
    %% Permite al cloud detectar sucursales offline (sin log en 24hs).
    %% AUDIT-FIRST: append-only enforced. Métricas operacionales por
    %% ciclo de sync. Retención corta (particionar por mes, purgar >1 año).
    sync_log {
        %% [A] Business
        uuid uuid PK
        uuid uuid_sucursal FK
        timestamp timestamp "inicio del ciclo de sync"
        int operaciones_enviadas
        int operaciones_exitosas
        int operaciones_fallidas
        int conflictos
        int duracion_ms
        %% Retention (operacional — 1 año)
        date fecha_retencion_hasta
        %% Audit
        timestamp created_at
        uuid created_by
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

    %% log_transaccional: Log append-only de cada acción del sistema.
    %% Permite auditoría completa: quién hizo qué, cuándo y dónde.
    %% AUDIT-FIRST: cadena de hash para integridad probatoria. Es la
    %% fuente de verdad para reconstruir cualquier cambio de estado
    %% (tablas [V] derivan de acá). Cada fila encadena con la anterior
    %% del mismo uuid_sucursal vía hash_anterior → hash_actual.
    %%
    %% hash_anterior = SHA256(uuid + datos_anteriores + datos_nuevos
    %%   + accion + uuid_usuario + timestamp_evento + timestamp_registro
    %%   + hash_anterior del log previo del mismo uuid_sucursal).
    %% hash_actual = SHA256(uuid + timestamp_registro + hash_anterior).
    %% Única fila con hash_anterior NULL es el primer log por sucursal
    %% (semilla de la cadena).
    %%
    %% datos_anteriores y datos_nuevos son snapshots JSON del registro
    %% afectado antes y después del cambio. NULL para eventos sin
    %% mutación (ej: login). Para eventos derivados de la lectura
    %% de otros logs, referenciar vía uuid_referencia.
    log_transaccional {
        %% [A] Business
        uuid uuid PK
        uuid uuid_usuario FK
        uuid uuid_sucursal FK
        string accion "crear | actualizar | eliminar | revocar | archivar | etc."
        string tabla_afectada "tabla sobre la que se actuó"
        uuid uuid_registro_afectado "uuid del registro en tabla_afectada"
        uuid uuid_referencia "opcional: FK al evento origen (ej: anulaciones)"
        json datos_anteriores "snapshot pre-cambio (NULL si es creación)"
        json datos_nuevos "snapshot post-cambio (NULL si es lectura)"
        timestamp timestamp_evento "cuándo ocurrió la acción en el negocio"
        %% Chain integrity (audit probatorio)
        string hash_anterior "SHA256 del log previo del mismo uuid_sucursal"
        string hash_actual "SHA256 de esta fila + hash_anterior"
        %% Retention (compliance — depende de la acción; default 5 años)
        date fecha_retencion_hasta
        %% Audit
        timestamp created_at "cuándo la DB registró la fila"
        uuid created_by
        %% Sync
        string sync_status
        timestamp sync_timestamp
        int sync_attempts
    }

