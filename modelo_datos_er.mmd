    %% ============================================================
    %% AUDIT-FIRST: ENFORCEMENT Y REGLAS DE INMUTABILIDAD
    %% ============================================================
    %%
    %% NIVEL DB (PostgreSQL):
    %%
    %% 1. REVOKE UPDATE, DELETE ON [A]_tables FROM rol_app;
    %%    El rol de la app solo tiene INSERT y SELECT en tablas [A].
    %%    Excepción: sync_queue permite UPDATE sobre campos operacionales
    %%    (estado, intentos, next_retry_at, ultimo_error).
    %%
    %% 2. Trigger BEFORE UPDATE OR DELETE en cada tabla [A] (excepto sync_queue):
    %%    CREATE FUNCTION reject_mutation() RETURNS trigger AS $$
    %%    BEGIN
    %%      RAISE EXCEPTION 'tabla append-only: % prohibido en %',
    %%        TG_OP, TG_TABLE_NAME;
    %%    END;
    %%    $$ LANGUAGE plpgsql;
    %%
    %% 3. GRANT BYPASSRLS a un rol_admin_auditor (separado del rol_app)
    %%    para investigaciones de fraude; deja痕 en log_transaccional.
    %%
    %% 4. Tablas [L-E] y [L-W]: INSERT-only. UPDATE/DELETE prohibidos
    %%    a nivel DB. Cada cambio = nueva fila.
    %%
    %% 5. Tablas [L-S] (login, sesion): UPDATE permitido SOLO sobre
    %%    campos `estado` y `timestamp_cierre`/`timestamp_apertura`. Trigger
    %%    valida que UPDATE no toque otros campos + que INSERT en
    %%    log_transaccional ocurra en la misma TX.
    %%
    %% 6. Tablas [V]: INSERT y UPDATE via API versionada. DELETE solo
    %%    via archivado (nueva fila con vigente_hasta=NOW()).
    %%
    %% NIVEL APLICACIÓN:
    %%
    %% - Tablas [L-E] (ingreso, facturas, factura_electronica):
    %%   el estado se DERIVA de otros eventos. NO se muta.
    %%
    %% - Tablas [L-W] (anulaciones, reclamos, alerta, reimpresion_ticket):
    %%   cada transición de estado es NUEVA fila encadenada por
    %%   uuid_padre (o uuid_anulacion_padre / uuid_reclamo_padre /
    %%   uuid_alerta_padre). El estado vigente es la última fila de la cadena.
    %%
    %% - Tablas [L-S] (login, sesion): UPDATE legítimo sobre estado/cierre
    %%   con INSERT obligatorio en log_transaccional en la misma TX.
    %%
    %% - Cada cambio en tablas [V] registra evento en log_transaccional
    %%   con datos_anteriores y datos_nuevos (snapshot JSON).
    %%
    %% - Cada revocación de e-factura registra fila en revocacion_factura
    %%   con cadena de hash por uuid_sucursal.
    %%
    %% RETENCION:
    %%
    %% - Tablas DIAN (facturas, factura_electronica, factura_detalle,
    %%   factura_impuestos, factura_otros_cobros, factura_pagos,
    %%   revocacion_factura): fecha_retencion_hasta = created_at +
    %%   dias_retencion_empresa (configurado en `empresa`, default 5 años).
    %%   Particionar por año fiscal para purga controlada.
    %%
    %% - log_transaccional: fecha_retencion_hasta = created_at + dias_retencion_accion
    %%   (default 5 años; ampliable a 10 para acciones de facturación).
    %%
    %% - Tablas operacionales (caja, arqueo, sync_log, sync_conflict):
    %%   1-2 años. Particionar por mes.
    %%
    %% HASH CHAIN (integridad probatoria):
    %%
    %% - log_transaccional y revocacion_factura mantienen cadena de
    %%   hash por uuid_sucursal. La verificación de cadena corre como
    %%   job nightly y alerta si encuentra inconsistencia.
    %%
    %% - Verificación: SELECT hash_actual, hash_calculado FROM (
    %%     SELECT *, SHA256(...) OVER (PARTITION BY uuid_sucursal
    %%     ORDER BY created_at) AS hash_calculado FROM log_transaccional
    %%   ) WHERE hash_actual != hash_calculado;
    %%
    %% CONSULTAS BI-TEMPORALES (proyección):
    %%
    %% - "Estado actual de usuarios al 2024-03-15":
    %%   SELECT * FROM usuarios
    %%   WHERE vigente_desde <= '2024-03-15'
    %%     AND (vigente_hasta IS NULL OR vigente_hasta > '2024-03-15');
    %%
    %% - "Quién modificó la tarifa X y cuándo":
    %%   SELECT * FROM log_transaccional
    %%   WHERE tabla_afectada = 'tarifas_sucursal'
    %%     AND uuid_registro_afectado = ?;
