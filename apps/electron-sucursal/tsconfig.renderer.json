{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.renderer.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/lib/**/*.ts",
    "src/lib/**/*.tsx",
    "src/state/**/*.ts",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/features/operacion/**/*.ts",
    "src/features/operacion/**/*.tsx",
    "src/features/caja/**/*.ts",
    "src/features/caja/**/*.tsx",
    "src/features/catalogos/**/*.ts",
    "src/features/catalogos/**/*.tsx",
    "src/features/auth/**/*.ts",
    "src/features/auth/**/*.tsx",
    "src/features/facturacion/**/*.ts",
    "src/features/facturacion/**/*.tsx",
    "src/features/reimpresion/**/*.ts",
    "src/features/reimpresion/**/*.tsx",
    "src/features/suscripciones/**/*.ts",
    "src/features/suscripciones/**/*.tsx",
    "src/features/sync/**/*.ts",
    "src/features/sync/**/*.tsx",
    "src/shared/**/*.ts"
  ]
}
