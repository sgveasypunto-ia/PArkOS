# Local artifacts and tooling state. Do not commit.
.agent-generated/
.atl/
.codegraph/
.venv/
.venv-py313/
node_modules/
dist/
build/
# electron-builder's build/ under electron-sucursal is a SOURCE asset
# directory (icon.ico, entitlements.mac.plist), not build output - the
# blanket `build/` rule above would otherwise silently drop the real app
# icon from version control (confirmed: `git check-ignore` matched it),
# reintroducing the WiX LGHT0094 MSI-target failure for anyone else who
# clones this repo and runs installer/build-release.ps1.
!apps/electron-sucursal/build/
!apps/electron-sucursal/build/**
coverage/
htmlcov/
__pycache__/
*.pyc
*.pyo
*.pyd

# Local environment overrides
.env
.env.local
.env.*.local

# Deploy-specific env files (may hold provider URLs/token paths) — never commit
infra/deploy/.env.*

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vite/
.coverage
.coverage.*

# TypeScript incremental build cache + per-task verify configs
# (apps/electron-sucursal/tsconfig.f4-3-verify.json, etc.)
*.tsbuildinfo
tsconfig.*-verify.json

# Playwright / Vitest runtime artifacts
test-results/
playwright-report/
playwright/.cache/

# IDE
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# OS scratch
tmp/
temp/

# Local dev secrets � never commit (see infra/deploy/secrets/README.md)
infra/deploy/secrets/*.pem
infra/deploy/secrets/*.jwt
infra/deploy/secrets/factus_token

# Agent workspace (aranda-agent-workspace)
.agent-generated/
